# ── MongoDB ────────────────────────────────────────────
# 예산설정(budget-dashboard)과 같은 클러스터를 쓰고 DB 만 따로 (designdesk)
MONGODB_URI=mongodb+srv://...
MONGODB_DB=designdesk

# ── 디자인팀 로그인 ────────────────────────────────────
# 디자인팀(편집자) 비밀번호. 요청자는 로그인 없이 씁니다.
ADMIN_PASSWORD=
# 쿠키 서명용 임의 문자열 (32자 이상 권장)
SESSION_SECRET=

# ── 이미지·결과물 저장소 (드롭박스) ─────────────────────
# 요청 폴더가 쌓일 곳 (팀 스페이스 맨 위 기준 드롭박스 경로)
DROPBOX_ROOT=/2026_요기코퍼레이션_온라인·마케팅·디자인/03_디자인/11_디자인요청 데스크

# 방법 1) 드롭박스 API — 배포 서버용. 셋 다 있으면 API 로 저장 (`npm run dropbox:auth` 로 리프레시 토큰 발급)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# 방법 2) 이 PC 의 드롭박스 동기화 폴더 맨 위 — API 키 없이 이 PC 에서 바로 드롭박스에 저장
# 예) DROPBOX_LOCAL_DIR=C:/Users/Yogibo Design/Yogicorporation Dropbox
DROPBOX_LOCAL_DIR=

# 둘 다 비우면 ./.data/dropbox 에 같은 구조로 저장 (시험용)

# 저장 방식 강제 (선택): local → 키가 있어도 방법 2(또는 시험 폴더) · api → 방법 1 · 비우면 키가 있으면 API
# 이 PC 는 local 로 두고 배포 서버(Vercel)에는 넣지 않음. 시험 서버(7201)는 꼭 local + 시험 폴더로.
DROPBOX_MODE=
